# 校园资源采集系统 .gitignore

# 敏感配置文件
config.env
*.pem
*.key
jwt_*
secrets.yaml

# 数据库文件
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# 日志文件
logs/
*.log
audit_logs/

# 临时文件和下载目录
temp/
downloads/

# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# 测试产物
*.test
*.out
coverage.txt
coverage.html

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# 前端构建产物
web/dist/
web/node_modules/

# 依赖目录
vendor/

# 运行时文件
runtime/
